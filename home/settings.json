{
  "model": "opus",
  "effortLevel": "high",
  "fallbackModel": ["sonnet"],
  "language": "german",
  "cleanupPeriodDays": 30,
  "permissions": {
    "defaultMode": "default",
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Edit(**/.env)",
      "Edit(**/.env.*)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(**/id_rsa*)"
    ],
    "ask": [
      "Bash(git push *)",
      "Bash(gh pr merge *)"
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "python \"$HOME/.claude/statusline.py\""
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "python \"$HOME/.claude/hooks/guard_shell.py\"",
            "timeout": 10,
            "statusMessage": "guard_shell prüft den Befehl"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python \"$HOME/.claude/hooks/context_radar.py\"",
            "timeout": 5
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "compact",
        "hooks": [
          {
            "type": "command",
            "command": "python \"$HOME/.claude/hooks/reinject.py\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
